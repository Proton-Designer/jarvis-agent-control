<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jarvis.l1wakeword</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/aymanmohammed/Desktop/Jarvis/l1_wakeword/run_daemon.sh</string>
    </array>

    <!-- Survives reboot (RunAtLoad) and crashes/abnormal exits (KeepAlive
         SuccessfulExit:false) -- but a CLEAN exit (daemon.py handles
         SIGTERM/SIGINT and exits 0) stays down. This is deliberate, not
         the bare-true form used in an earlier version of this file: a
         microphone listener that resurrects itself after a deliberate
         `kill` is, from the outside, indistinguishable from something
         that can't be turned off -- a trust problem independent of
         whether the code is correct. `kill`, stop_wakeword.sh (which
         also fully unloads via launchctl bootout), and a wedged/crashed
         process recovering on its own are now three properties that all
         behave the way a reasonable person expects. See README's
         "How to turn this off" section, which is first in the file on
         purpose. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aymanmohammed/Desktop/Jarvis/l1_wakeword/logs/wakeword.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aymanmohammed/Desktop/Jarvis/l1_wakeword/logs/wakeword.error.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
